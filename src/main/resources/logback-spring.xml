<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs estruturados da aplicacao — RFC-0004.

  Dois perfis de saida, escolhidos pelo profile ativo do Spring:

    - `production` (e qualquer perfil que nao seja `local`/`test`): uma linha
      JSON por evento, em stdout. E dai que o agente do OpenTelemetry recolhe
      os logs e os entrega ao Loki.

    - `local` / `test`: o padrao legivel do Spring Boot. Ler JSON cru no
      terminal durante o desenvolvimento nao ajuda ninguem.

  O campo que faz o sistema inteiro se conectar e o `trace_id`. Ele chega no
  MDC pelo micrometer-tracing-bridge-otel, e o Grafana usa esse valor para
  ligar cada linha de log ao trace correspondente no Tempo. Os nomes sao em
  snake_case de proposito: e o formato que o datasource do Loki procura
  (derivedFields, em modules/observability/values/kube-prometheus-stack.yaml.tftpl).
-->
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="applicationName" source="spring.application.name" defaultValue="mechanical-hub"/>
    <springProperty scope="context" name="environment" source="mechanical-hub.environment" defaultValue="production"/>

    <!-- ── Producao: uma linha JSON por evento ─────────────────────────── -->
    <springProfile name="!local &amp; !test">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp>
                        <fieldName>timestamp</fieldName>
                        <timeZone>UTC</timeZone>
                    </timestamp>
                    <logLevel>
                        <fieldName>level</fieldName>
                    </logLevel>
                    <loggerName>
                        <fieldName>logger</fieldName>
                        <shortenedLoggerNameLength>40</shortenedLoggerNameLength>
                    </loggerName>
                    <threadName>
                        <fieldName>thread</fieldName>
                    </threadName>
                    <message>
                        <fieldName>message</fieldName>
                    </message>

                    <!--
                      Correlacao. Os valores vem do MDC; `:-` deixa o campo
                      vazio quando nao ha trace ativo (tarefa agendada,
                      inicializacao) em vez de derrubar o encoder.
                    -->
                    <pattern>
                        <omitEmptyFields>true</omitEmptyFields>
                        <pattern>
                            {
                              "service_name": "${applicationName:-mechanical-hub}",
                              "environment": "${environment:-production}",
                              "trace_id": "%mdc{traceId:-}",
                              "span_id": "%mdc{spanId:-}",
                              "user_id": "%mdc{user_id:-}",
                              "user_role": "%mdc{user_role:-}",
                              "http_method": "%mdc{http_method:-}",
                              "http_path": "%mdc{http_path:-}"
                            }
                        </pattern>
                    </pattern>

                    <!-- Qualquer outra chave que o codigo tenha colocado no MDC. -->
                    <mdc>
                        <excludeMdcKeyName>traceId</excludeMdcKeyName>
                        <excludeMdcKeyName>spanId</excludeMdcKeyName>
                        <excludeMdcKeyName>traceFlags</excludeMdcKeyName>
                        <excludeMdcKeyName>user_id</excludeMdcKeyName>
                        <excludeMdcKeyName>user_role</excludeMdcKeyName>
                        <excludeMdcKeyName>http_method</excludeMdcKeyName>
                        <excludeMdcKeyName>http_path</excludeMdcKeyName>
                    </mdc>

                    <stackTrace>
                        <fieldName>stack_trace</fieldName>
                        <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                            <maxDepthPerThrowable>25</maxDepthPerThrowable>
                            <maxLength>4096</maxLength>
                            <rootCauseFirst>true</rootCauseFirst>
                        </throwableConverter>
                    </stackTrace>
                </providers>
            </encoder>
        </appender>

        <root level="WARN">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <!-- ── Desenvolvimento e testes: saida legivel ─────────────────────── -->
    <springProfile name="local | test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level [%X{traceId:-},%X{spanId:-}] %logger{36} - %msg%n</pattern>
            </encoder>
        </appender>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <logger name="com.fiap.mechanical_hub" level="INFO"/>

</configuration>
